{
  "info": {
    "name": "Tigger Supabase REST",
    "_postman_id": "a3a5c1d4-0f2e-4d98-9c2d-collection",
    "description": "Postman collection to test Supabase PostgREST endpoints for Tigger.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "_Env Setup",
      "item": [
        {
          "name": "WhoAmI (JWT decode at jwt.io)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://jwt.io",
              "protocol": "https",
              "host": [
                "jwt",
                "io"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Leads",
      "item": [
        {
          "name": "List leads",
          "request": {
            "method": "GET",
            "header": [
              { "key": "apikey", "value": "{{apikey}}" },
              { "key": "Authorization", "value": "Bearer {{jwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/rest/v1/leads?select=*&order=created_at.desc&limit=25",
              "host": [ "{{baseUrl}}" ],
              "path": [ "rest", "v1", "leads" ],
              "query": [
                { "key": "select", "value": "*" },
                { "key": "order", "value": "created_at.desc" },
                { "key": "limit", "value": "25" }
              ]
            }
          }
        },
        {
          "name": "Get lead by id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "apikey", "value": "{{apikey}}" },
              { "key": "Authorization", "value": "Bearer {{jwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/rest/v1/leads?id=eq.{{lead_id}}&select=*",
              "host": [ "{{baseUrl}}" ],
              "path": [ "rest", "v1", "leads" ],
              "query": [
                { "key": "id", "value": "eq.{{lead_id}}" },
                { "key": "select", "value": "*" }
              ]
            }
          }
        },
        {
          "name": "Insert lead",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{apikey}}" },
              { "key": "Authorization", "value": "Bearer {{jwt}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Prefer", "value": "return=representation" }
            ],
            "url": {
              "raw": "{{baseUrl}}/rest/v1/leads",
              "host": [ "{{baseUrl}}" ],
              "path": [ "rest", "v1", "leads" ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lead_id\": \"LD-TEST\",\n  \"customer_name\": \"Test Lead\",\n  \"email\": \"lead@test.com\",\n  \"phone\": \"9999999999\",\n  \"status\": \"warm\",\n  \"sub_status\": \"newLead\",\n  \"source\": \"website\",\n  \"property_type\": \"residential\",\n  \"category_type\": \"a\",\n  \"assigned_to\": \"{{user_id}}\",\n  \"assigned_to_name\": \"Test User\",\n  \"created_by\": \"{{user_id}}\",\n  \"created_by_name\": \"Test User\"\n}"
            }
          }
        },
        {
          "name": "Update lead (by id)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "apikey", "value": "{{apikey}}" },
              { "key": "Authorization", "value": "Bearer {{jwt}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Prefer", "value": "return=representation" }
            ],
            "url": {
              "raw": "{{baseUrl}}/rest/v1/leads?id=eq.{{lead_id}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "rest", "v1", "leads" ],
              "query": [ { "key": "id", "value": "eq.{{lead_id}}" } ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Updated Name\"\n}"
            }
          }
        },
        {
          "name": "Delete lead (by id)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "apikey", "value": "{{apikey}}" },
              { "key": "Authorization", "value": "Bearer {{jwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/rest/v1/leads?id=eq.{{lead_id}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "rest", "v1", "leads" ],
              "query": [ { "key": "id", "value": "eq.{{lead_id}}" } ]
            }
          }
        }
      ]
    },
